# Copy this file to .env for local development.
# Never upload, email, or commit .env.

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PROFESSOR_DB_PATH=data/professors.db

# local = owner development experience; public = deployment defaults.
APP_MODE=local
# Optional explanation requests: set to 0 for offline/local verification.
# AI_EXPLANATIONS=0
# AI_EXPLANATIONS_PER_USER_HOUR=20
# AI_EXPLANATIONS_PER_DAY=200
ENABLE_DEMO_DATA=false
ENABLE_AI_SEARCH=true

# Owner tools. Keep true locally. Set false for the public deployment.
ENABLE_ADMIN_TOOLS=true
# Optional local/private password protection. Leave both blank to unlock locally.
ADMIN_PASSWORD=
ADMIN_PASSWORD_SHA256=

# Cost controls. 0 for MAX_AI_SEARCHES_PER_DAY means unlimited.
MAX_AI_SEARCHES_PER_SESSION=25
MAX_AI_SEARCHES_PER_DAY=500

# Put your contact email here before larger scraping runs.
SCRAPER_CONTACT_EMAIL=

# --- Gmail drafts + status (Phase 5, Phase 7) ---------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with the authorized redirect URI below, then copy client id/secret here.
# Do not commit real values to .env.example.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# The app requests gmail.compose (manage drafts and send) plus gmail.metadata
# (read message metadata, never bodies) so it can detect sent/replied status.
# Nothing is ever sent automatically and message bodies are never read.
# The backend must be reachable at this URI during OAuth consent.
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/callback
# Where the browser returns after connecting (defaults to the composer root).
GMAIL_REDIRECT_SUCCESS_URL=http://localhost:3000/outreach
# Tokens are stored unencrypted (permission-protected) by default. Set a Fernet
# key to encrypt them at rest; requires the optional `cryptography` package.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Override where per-user OAuth tokens live (default: data/gmail_tokens).
# GMAIL_TOKEN_DIR=data/gmail_tokens

# --- App sign-in (Phase 6) ----------------------------------------------------
# Google Sign-In for the app itself. This is a SEPARATE OAuth client from the
# Gmail client above: create another client ID/secret and only request
# the identity scopes (openid, email, profile) via the backend callback.
# For local development only, explicitly opt in to the developer account if needed.
# AUTH_ALLOW_DEV_LOGIN=true
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# The backend must be reachable at this URI during sign-in consent.
AUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Where the browser returns after sign-in (defaults to /account).
AUTH_LOGIN_SUCCESS_URL=http://localhost:3000/account
# Session behavior. Cookies are HttpOnly + SameSite=Lax; set AUTH_COOKIE_SECURE=true
# when serving over HTTPS. Each account holds one active session at a time.
# AUTH_SESSION_COOKIE_NAME=rmf_session
# AUTH_SESSION_DAYS=14
# AUTH_COOKIE_SECURE=false
# Developer login is disabled by default. Enable only with APP_MODE=local and AUTH_ALLOW_DEV_LOGIN=true.
# AUTH_ALLOW_DEV_LOGIN=true
# AUTH_DEV_EMAIL=dev@localhost
