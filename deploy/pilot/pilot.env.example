# Replace the hostname and enter secrets only in Railway's private Variables UI.
# Do not upload this file as a populated .env.
PORT=8080
# Keep private until public acceptance is complete and publication is approved.
PILOT_ACCESS_MODE=private
PILOT_BASIC_USER=owner
PILOT_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
AUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_IDENTITY_CLIENT_ID
AUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_IDENTITY_CLIENT_SECRET
AUTH_REDIRECT_URI=https://YOUR-PILOT-HOST/api/auth/callback
AUTH_LOGIN_SUCCESS_URL=https://YOUR-PILOT-HOST/account
CORS_ORIGINS=https://YOUR-PILOT-HOST
# Configure the separate Gmail client before using Gmail in the hosted pilot.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_REDIRECT_URI=https://YOUR-PILOT-HOST/api/gmail/callback
GMAIL_REDIRECT_SUCCESS_URL=https://YOUR-PILOT-HOST/outreach
# Optional private ciphertext storage, enabled only after bucket verification.
OFFSITE_BACKUPS=false
OFFSITE_BUCKET=
OFFSITE_ENDPOINT=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_REGION=auto
OFFSITE_PREFIX=professor-finder-v1
