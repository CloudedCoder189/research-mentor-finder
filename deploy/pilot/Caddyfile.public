{
    admin off
    auto_https off
}
:{$PORT:8080} {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    handle /__pilot_health {
        reverse_proxy 127.0.0.1:18503
    }
    handle /__pilot_monitor {
        reverse_proxy 127.0.0.1:18503
    }
    # Detailed retention/bucket diagnostics are for operators, not visitors.
    @diagnostics path /api/health /api/health/*
    handle @diagnostics {
        respond "Not found" 404
    }
    # Information pages remain accessible without account sign-in.
    @information path /about /privacy /terms /contact
    handle @information {
        root * {$PUBLIC_INFO_ROOT:/app/deploy/pilot/public-info}
        rewrite * {path}.html
        file_server
    }
    handle {
        request_body {
            max_size 1MB
        }
        @api path /api /api/*
        handle @api {
            reverse_proxy 127.0.0.1:18501 {
                header_up -Authorization
                # This value is trusted only from Railway's sanitized public
                # HTTP edge. Do not expose this gateway via an unsanitized TCP
                # proxy or an untrusted service on Railway private networking.
                header_up X-RMF-Client-IP {http.request.header.X-Real-IP}
            }
        }
        handle {
            reverse_proxy 127.0.0.1:13310 {
                header_up -Authorization
            }
        }
    }
}
